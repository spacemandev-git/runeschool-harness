# Copy values into an untracked .env file or inject them through your secret manager.
# Never commit live credentials.
NOUS_API_KEY=replace-with-your-provider-key
NOUS_MODEL=openai/gpt-5.5-pro
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

# Optional OpenRouter provider included in the default model configuration.
OR_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-role overrides accept provider:model or a bare model on the default provider.
# HARNESS_MODEL_DIRECTOR=nous:openai/gpt-5.5-pro
# HARNESS_MODEL_ADMIN=nous:openai/gpt-5.5-pro
# HARNESS_MODEL_COORDINATOR=nous:openai/gpt-5.5-pro
# HARNESS_MODEL_AGENT=nous:openai/gpt-5.5-pro
# HARNESS_MODEL_SUMMARIZER=nous:openai/gpt-5.5-pro

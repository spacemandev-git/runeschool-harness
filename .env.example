# Copy this file to .env and replace the examples. Never commit live credentials.

# Any OpenAI-compatible endpoint: Nous, OpenRouter, vLLM, Ollama, or your own router.
ROUTER_API_BASE=https://your-router.example/v1
ROUTER_API_KEY=replace-with-your-router-key

# Initial model for every role. Models can be changed per director, coordinator, or agent in the cockpit.
ROUTER_MODEL=openai/gpt-5.5-pro

# RuneSchool server base URL. Harness hosts can read this with loadHarnessEnvironment().
RUNESCHOOL_API_BACKEND=http://127.0.0.1:7800

# Optional endpoint overrides. By default these are derived from RUNESCHOOL_API_BACKEND.
# RUNESCHOOL_MCP_URL=http://127.0.0.1:7800/mcp
# RUNESCHOOL_UI_URL=http://localhost:5300
